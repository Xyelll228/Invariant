---
/** Вкладки уровней темы: Фундамент, База, Глубина. У каждого уровня своя страница. */
import type { Level } from '../../content/schema.ts';
import { url } from '../../lib/site.ts';

interface Props {
  levels: { level: Level; title: string; path: string; minutes: number }[];
  current: Level;
}

const { levels, current } = Astro.props;
---

<nav class="level-tabs" aria-label="Уровни темы">
  <ul>
    {
      levels.map((item) => (
        <li>
          <a href={url(item.path)} aria-current={item.level === current ? 'page' : undefined}>
            <span class="level-tabs__title">{item.title}</span>
            <span class="level-tabs__time">≈ {item.minutes} мин чтения</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .level-tabs ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 var(--space-6);
  }

  .level-tabs li + li {
    margin-top: 0;
  }

  .level-tabs a {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    text-decoration: none;
    line-height: 1.3;
  }

  .level-tabs a:hover {
    background: var(--color-surface);
  }

  .level-tabs a[aria-current='page'] {
    background: var(--color-inverse-bg);
    border-color: var(--color-inverse-bg);
    color: var(--color-inverse-text);
  }

  .level-tabs__title {
    font-weight: 650;
  }

  .level-tabs__time {
    font-size: 0.8125rem;
  }
</style>
