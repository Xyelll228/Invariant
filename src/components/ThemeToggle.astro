---
import { t } from '../i18n/index.ts';

const initialLabel = t('theme.button', { name: t('theme.system') });
---

<button type="button" class="theme-toggle" data-theme-toggle data-state="system" title={initialLabel}>
  <svg class="theme-toggle__icon theme-toggle__icon--system" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path
      d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
  </svg>
  <span class="visually-hidden" data-theme-label>{initialLabel}</span>
</button>

<script>
  import { initThemeToggle } from '../scripts/theme.ts';

  initThemeToggle();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--color-surface);
  }

  .theme-toggle__icon {
    width: 22px;
    height: 22px;
    display: none;
  }

  .theme-toggle[data-state='system'] .theme-toggle__icon--system,
  .theme-toggle[data-state='light'] .theme-toggle__icon--light,
  .theme-toggle[data-state='dark'] .theme-toggle__icon--dark {
    display: block;
  }
</style>
