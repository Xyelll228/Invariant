---
/**
 * Блок темы. У каждого блока постоянный id: на него ведут ссылки из разборов
 * ошибок, глоссария и сообщений «нашёл ошибку». Версия растёт, когда меняется
 * смысл блока.
 *
 * Доказательства на уровнях Фундамент и База свёрнуты (ТЗ, «Справочник»).
 */
import type { BlockKind } from '../../content/schema.ts';
import QuestionList from '../learn/QuestionList.tsx';
import ReportButton from '../report/ReportButton.astro';
import NoteSlot from './NoteSlot.astro';

interface Props {
  id: string;
  kind: BlockKind;
  version: number;
  title: string;
}

const { id, kind, version, title } = Astro.props;
const topic = Astro.locals.topic;
const collapsed = kind === 'proof' && topic !== undefined && topic.level !== 'depth';
// Короткие вопросы после блока (ТЗ, шаг «Понять»).
const attached = topic?.byBlock?.[id] ?? [];
---

<section class="block" id={id} data-kind={kind} data-version={version}>
  {
    collapsed ? (
      <details class="block__details">
        <summary class="block__summary">
          <h3 class="block__title">{title}</h3>
          <span class="block__toggle muted">показать доказательство</span>
        </summary>
        <div class="block__body">
          <slot />
        </div>
      </details>
    ) : (
      <>
        <h3 class="block__title">
          <a class="block__anchor" href={`#${id}`}>
            {title}
          </a>
        </h3>
        <div class="block__body">
          <slot />
        </div>
      </>
    )
  }
  {
    topic && (
      <>
        <NoteSlot blockId={id} />
        <div class="block__footer">
          <ReportButton topicId={topic.id} topicTitle={topic.title} targetId={id} targetTitle={title} version={version} />
          <button
            type="button"
            class="block-tool"
            data-block-note={id}
            data-block-title={title}
            data-block-path={`${topic.levelPath ?? ''}#${id}`}
            aria-label={`Заметка: ${title}`}
            aria-haspopup="dialog"
          >
            Заметка
          </button>
          <button
            type="button"
            class="block-tool"
            data-block-card={id}
            data-block-title={title}
            data-block-path={`${topic.levelPath ?? ''}#${id}`}
            aria-label={`Сделать карточку: ${title}`}
            aria-haspopup="dialog"
          >
            Сделать карточку
          </button>
        </div>
      </>
    )
  }
  {
    topic?.context && attached.length > 0 && (
      <QuestionList
        client:visible
        topic={topic.context}
        level={topic.level}
        questions={attached}
        mode="learn"
        base={topic.base ?? ''}
        runnerUrl={topic.runnerUrl ?? ''}
        title="Проверьте себя"
      />
    )
  }
</section>

<style>
  .block {
    margin: 0 0 var(--space-6);
  }

  .block__title {
    margin-top: var(--space-6);
  }

  .block__anchor {
    text-decoration: none;
  }

  .block__anchor:hover {
    text-decoration: underline;
  }

  .block__details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0 var(--space-4);
    margin-top: var(--space-6);
  }

  .block__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    min-height: var(--tap);
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style-position: inside;
  }

  .block__summary .block__title {
    display: inline;
    margin: 0;
  }

  .block__details[open] .block__toggle {
    display: none;
  }

  .block__details[open] {
    padding-bottom: var(--space-2);
  }

  .block__body > :last-child {
    margin-bottom: 0;
  }

  .block__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin-top: var(--space-2);
  }
</style>
