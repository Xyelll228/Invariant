---
/**
 * Главная (ТЗ, «Экраны»): «Продолжить», «Повторение» и разделы. «Продолжить»
 * и «Повторение» видны, когда в этом браузере уже есть прогресс; до тех пор
 * здесь разделы и подсказка, с чего начать.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContinueCard from '../../components/home/ContinueCard.tsx';
import { catalog, folders } from '../../content/catalog-data.ts';
import { catalogTotals } from '../../content/catalog.ts';
import { modulePath, sectionPath } from '../../content/paths.ts';
import { loadSite } from '../../content/site-data.ts';
import { t } from '../../i18n/index.ts';
import { url } from '../../lib/site.ts';

const site = await loadSite();
const published = [...site.pages.values()].filter((page) => !page.draft).length;
const totals = catalogTotals(catalog);
// Темы, у которых есть страницы, — для карточки «Продолжить».
const continueTopics = [...site.pages.values()].map((page) => ({
  id: page.topic.id,
  title: page.topic.title,
  levels: page.levels.map((level) => ({ level: level.level, title: level.title, path: level.path })),
}));
---

<BaseLayout>
  <div class="prose">
    <h1>{t('site.name')}</h1>
    <p class="lead">
      Открытое приложение для глубокого изучения алгоритмов и структур данных, баз данных и SQL, C и C++, Python и
      математики для информатики — с треком подготовки к собеседованиям.
    </p>
    <p>
      Цель — чтобы вы умели объяснить, доказать, написать код сам, измерить его и помнили это через месяцы, а не узнавали
      правильный ответ среди вариантов.
    </p>

    <div class="continue-slot">
      <ContinueCard client:load topics={continueTopics} base={url()} />
    </div>

    {/* Без счётчика «к повторению» — по решению владельца: только вход в повторение. */}
    <section class="card review-slot" aria-labelledby="review-title">
      <h2 id="review-title" class="card__title">Повторение</h2>
      <p>Навыки возвращаются по расписанию — в день, когда их пора вспомнить. Каждый раз задание новое.</p>
      <p>
        <a class="button" href={url('ru/review/')}>Перейти к повторению</a>
      </p>
    </section>

    <h2>С чего начать</h2>
    <ul>
      <li>
        Если программируете впервые — с раздела <a href={url(sectionPath('js', folders))}>«Основы JavaScript»</a>: на нём
        написаны все упражнения.
      </li>
      <li>
        Если основы знаете — с любого модуля, например с <a href={url(modulePath('algo.sorting', folders))}>«Сортировок»</a>.
        Предпосылки каждой темы видны в её шапке.
      </li>
    </ul>

    <h2>Разделы</h2>
    <ul class="card-list home__sections">
      {
        catalog.sections.map((section) => (
          <li class="card">
            <a class="card__title home__section-link" href={url(sectionPath(section.id, folders))}>
              {section.number}. {section.title}
            </a>
            <p class="muted">{section.intro}</p>
          </li>
        ))
      }
    </ul>

    <h2>Что сейчас</h2>
    <p>
      Идёт первая волна: 59 тем, от основ JavaScript до сортировок. Вышло тем: {published} из {totals.topics}. Полный
      список — в <a href={url('ru/catalog/')}>каталоге</a>.
    </p>
  </div>
</BaseLayout>

<style>
  /* Место под «Продолжить» есть, только если в браузере уже есть прогресс. */
  .continue-slot,
  .review-slot {
    display: none;
  }

  :global(:root[data-progress]) .continue-slot {
    display: block;
    min-height: 11rem;
    margin: var(--space-5) 0;
  }

  :global(:root[data-progress]) .review-slot {
    display: block;
    margin: var(--space-5) 0;
  }

  .home__section-link {
    display: inline-block;
    text-decoration: none;
  }

  .home__section-link:hover {
    text-decoration: underline;
  }
</style>
