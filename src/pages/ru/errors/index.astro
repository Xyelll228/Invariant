---
/**
 * Журнал ошибок (ТЗ, «Разбор ошибок и повторение»). Ошибки хранятся только в
 * браузере, поэтому список собирает остров на странице.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ErrorLog from '../../../components/review/ErrorLog.tsx';
import { url } from '../../../lib/site.ts';
---

<BaseLayout title="Журнал ошибок" description="Ошибки из заданий и повторения: заблуждения, которые за ними стоят, частые заблуждения и заметки.">
  <div class="prose">
    <h1>Журнал ошибок</h1>
    <p class="lead">
      Каждая ошибка из заданий тем и повторения — с заблуждением, которое за ней стоит. Отметка «разобрался» ничего не
      удаляет: история остаётся.
    </p>
    <ErrorLog client:load base={url()} />
  </div>
</BaseLayout>
