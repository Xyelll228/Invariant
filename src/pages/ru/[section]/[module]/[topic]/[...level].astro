---
/**
 * Страница уровня темы (ТЗ, «Справочник»). Первый уровень живёт по адресу
 * темы, остальные — в подпапке: /ru/algorithms/sorting/insertion/base/.
 * Адреса строятся из постоянных id (src/content/paths.ts).
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/topic/Breadcrumbs.astro';
import LevelTabs from '../../../../../components/topic/LevelTabs.astro';
import PropertiesTable from '../../../../../components/topic/PropertiesTable.astro';
import TopicSources from '../../../../../components/topic/TopicSources.astro';
import TopicTerms from '../../../../../components/topic/TopicTerms.astro';
import ReportDialog from '../../../../../components/report/ReportDialog.astro';
import BlockTools from '../../../../../components/content/BlockTools.astro';
import NoteSlot from '../../../../../components/content/NoteSlot.astro';
import LevelCheck from '../../../../../components/learn/LevelCheck.tsx';
import LevelProgress from '../../../../../components/learn/LevelProgress.tsx';
import QuestionList from '../../../../../components/learn/QuestionList.tsx';
import { catalogTopics, folders } from '../../../../../content/catalog-data.ts';
import { mdxComponents } from '../../../../../content/mdx-components.ts';
import { catalogTopicPath, levelPath } from '../../../../../content/paths.ts';
import { LEVEL_TITLES, type Level } from '../../../../../content/schema.ts';
import { loadSite, preparedTopicFor } from '../../../../../content/site-data.ts';
import { topicContext, type PreparedQuestion } from '../../../../../lib/learning/question-types.ts';
import { stepTitle } from '../../../../../lib/learning/steps.ts';
import { capitalize, formatDate } from '../../../../../lib/format.ts';
import { url } from '../../../../../lib/site.ts';

export async function getStaticPaths() {
  const site = await loadSite();
  return [...site.pages.values()].flatMap((page) =>
    page.levels.map((level, index) => {
      const [, section, module, topic] = page.path.split('/');
      return {
        params: { section, module, topic, level: index === 0 ? undefined : level.level },
        props: { topicId: page.topic.id, level: level.level },
      };
    }),
  );
}

interface Props {
  topicId: string;
  level: Level;
}

const { topicId, level } = Astro.props;
const site = await loadSite();
const page = site.pages.get(topicId);
if (!page) throw new Error(`Нет страницы темы ${topicId}`);
const { topic, catalog } = page;
const current = page.levels.find((item) => item.level === level);
if (!current) throw new Error(`У темы ${topicId} нет уровня ${level}`);

const entry = await getEntry('levels', current.entryId);
if (!entry) throw new Error(`Нет текста уровня ${current.entryId}`);
const { Content } = await render(entry);

// Задания уровня (ТЗ, «Цикл изучения темы»): предвопросы, вопросы после блоков,
// задания шагов, итоговая и отложенная проверки. Всё вычислимое уже вычислено.
const prepared = await preparedTopicFor(topic.id);
const context = topicContext(prepared, level);
const own = prepared.questions.filter((question) => question.level === level);
const preQuestions = own.filter((question) => question.role === 'pre');
const practice = own.filter((question) => question.role === 'practice');
const checkQuestions = own.filter((question) => question.role === 'check');
const graded = own.filter((question) => question.role !== 'pre');
const blockIds = new Set(current.blocks.map((block) => block.id));
const byBlock: Record<string, PreparedQuestion[]> = {};
for (const question of practice) {
  if (question.block && blockIds.has(question.block)) (byBlock[question.block] ??= []).push(question);
}
const unattached = practice.filter((question) => !question.block || !blockIds.has(question.block));
const stepGroups = [...new Set(unattached.map((question) => question.step ?? 0))]
  .sort((a, b) => a - b)
  .map((step) => ({ step, questions: unattached.filter((question) => (question.step ?? 0) === step) }));
// Ссылки шагов в «Прохождении уровня» ведут к первому заданию шага на странице.
const anchors: Record<number, string> = {};
for (const question of [...preQuestions, ...practice]) {
  const step = question.role === 'pre' ? 0 : (question.step ?? 0);
  anchors[step] ??= question.id;
}
const base = url();
const runnerUrl = url('sandbox/runner.html');

// Компоненты текста темы читают тему и уровень из Astro.locals (src/env.d.ts).
Astro.locals.topic = { id: topic.id, title: topic.title, level, dir: page.dir, topicPath: page.path, levelPath: current.path, byBlock, context, base, runnerUrl };

const module = catalog.module;
const section = module.section;
const prerequisites = topic.prerequisites.map((item) => {
  const written = site.pages.get(item.topic);
  const listed = catalogTopics.get(item.topic);
  if (written) {
    return { title: written.topic.title, level: LEVEL_TITLES[item.level], href: levelPath(item.topic, item.level, written.topic.levels, folders), wave: null };
  }
  return { title: capitalize(listed?.title ?? item.topic), level: LEVEL_TITLES[item.level], href: catalogTopicPath(item.topic), wave: listed?.wave ?? null };
});
const terms = topic.terms.map((id) => site.glossary.get(id)).filter((term) => term !== undefined);
const statusTitle = { draft: 'черновик', auto: 'проверено автоматически', expert: 'проверено экспертом' }[topic.review.status];
const index = page.levels.indexOf(current);
const next = page.levels[index + 1];
const levelTitle = `${topic.title}: ${current.title}`;
---

<BaseLayout title={index === 0 ? topic.title : levelTitle} description={topic.summary}>
  <article class="topic" data-topic={topic.id} data-level={level}>
    <Breadcrumbs
      items={[
        { href: 'ru/catalog/', label: 'Каталог' },
        { href: page.sectionPath, label: `${section.number}. ${section.title}` },
        { href: page.modulePath, label: `${module.number} ${module.title}` },
      ]}
    />
    {
      page.draft && (
        <div class="note">
          <span class="note__title">Черновик</span>
          <p>Тема ещё не прошла проверку и на основном сайте не опубликована. Здесь её видно только в превью правки.</p>
        </div>
      )
    }
    <h1>{topic.title}</h1>
    <p class="lead">{topic.summary}</p>

    <dl class="topic__meta">
      {
        prerequisites.length > 0 && (
          <div>
            <dt>Нужно знать до</dt>
            <dd>
              <ul class="topic__list">
                {prerequisites.map((item) => (
                  <li>
                    <a href={url(item.href)}>{item.title}</a>, {item.level}
                    {item.wave !== null && <span class="muted"> — тема выйдет в волне {item.wave}</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
      <div>
        <dt>Статус проверки</dt>
        <dd>
          {statusTitle}, {formatDate(topic.review.date)}
        </dd>
      </div>
    </dl>

    <div class="topic__tools">
      <button type="button" class="block-tool" data-block-note="" data-block-title={topic.title} data-block-path={page.path} aria-haspopup="dialog">
        Заметка к теме
      </button>
    </div>
    <NoteSlot blockId="" />

    <LevelTabs topicId={topic.id} levels={page.levels} current={level} />

    <h2 class="topic__level-title">{current.title}</h2>
    {
      own.length > 0 && (
        <>
          <LevelProgress client:load topic={context} level={level} levelTitle={current.title} anchors={anchors} />
          <LevelCheck client:load kind="delayed" topic={context} level={level} levelTitle={current.title} questions={graded} base={base} runnerUrl={runnerUrl} />
        </>
      )
    }
    {level !== 'fundament' && <PropertiesTable topic={topic} />}

    {
      preQuestions.length > 0 && (
        <section class="step-section" aria-labelledby="step-0-title">
          <h3 id="step-0-title">Предвопросы</h3>
          <p>
            Перед чтением — несколько вопросов. Ошибаться здесь нормально: ответы не оцениваются и показывают, на что обратить
            внимание.
          </p>
          <QuestionList client:visible topic={context} level={level} questions={preQuestions} mode="pre" base={base} runnerUrl={runnerUrl} />
        </section>
      )
    }

    <Content components={mdxComponents} />

    {
      stepGroups.length > 0 && (
        <section class="step-section" aria-labelledby="tasks-title">
          <h2 id="tasks-title">Задания</h2>
          {stepGroups.map((group) => (
            <>
              <h3 id={`step-${group.step}`}>
                Шаг {group.step}. {stepTitle(group.step)}
              </h3>
              <QuestionList client:visible topic={context} level={level} questions={group.questions} mode="learn" base={base} runnerUrl={runnerUrl} />
            </>
          ))}
        </section>
      )
    }

    {
      checkQuestions.length > 0 && (
        <LevelCheck client:visible kind="check" topic={context} level={level} levelTitle={current.title} questions={checkQuestions} base={base} runnerUrl={runnerUrl} />
      )
    }

    {
      next && (
        <p class="topic__next">
          <a class="button" href={url(next.path)}>
            Следующий уровень: {next.title} →
          </a>
        </p>
      )
    }

    <TopicTerms terms={terms} />
    {page.sources && <TopicSources sources={page.sources} />}
  </article>
  <ReportDialog />
  <BlockTools topicId={topic.id} />
</BaseLayout>

<script>
  // Переход по ссылке на блок внутри свёрнутого доказательства раскрывает его.
  const reveal = () => {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const details = target?.closest('details') ?? target?.querySelector('details');
    if (details && !details.open) {
      details.open = true;
      target?.scrollIntoView();
    }
  };
  window.addEventListener('hashchange', reveal);
  reveal();
</script>

<style>
  /*
   * Текст — строкой удобной длины, а визуализации, код и таблицы — во всю
   * ширину страницы: им нужно место для столбиков и панели кода.
   */
  .topic :global(:is(h1, h2, h3, h4, p, ul, ol, dl, blockquote, details, .note, .breadcrumbs, .level-tabs)) {
    max-width: var(--measure);
  }

  .topic__meta > div {
    margin-bottom: var(--space-3);
  }

  .topic__meta dt {
    font-weight: 650;
  }

  .topic__meta dd {
    margin: 0;
  }

  .topic__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .topic__level-title {
    margin-top: 0;
  }

  .topic__next {
    margin: var(--space-6) 0;
  }
</style>
